# ─── Server Environment Variables ────────────────────────────
# Copy this file to .env and fill in your values

# ─── App ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_VERSION=v1
APP_NAME=MilkBoy
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# ─── Database ────────────────────────────────────────────────
# Use 'sqlite' for local development, 'postgresql' for production
DB_CLIENT=sqlite
# PostgreSQL connection (used when DB_CLIENT=postgresql)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=milkboy
DB_USER=milkboy
DB_PASSWORD=your_secure_password_here
# SQLite file path (used when DB_CLIENT=sqlite)
SQLITE_FILENAME=./data/milkboy.sqlite

# ─── Redis ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=false

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_64_char_string_in_production
JWT_REFRESH_SECRET=change_this_to_another_random_64_char_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Encryption ─────────────────────────────────────────────
ENCRYPTION_KEY=change_this_to_a_32_byte_hex_string

# ─── Email (SMTP) ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=MilkBoy <noreply@milkboy.app>
EMAIL_ENABLED=false

# ─── Storage ────────────────────────────────────────────────
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
# S3-compatible storage (used when STORAGE_TYPE=s3)
S3_BUCKET=milkboy-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# ─── AI Model ───────────────────────────────────────────────
AI_MODEL_PATH=./ai/models/milk-quality-v1
AI_CONFIDENCE_THRESHOLD=0.6

# ─── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Super Admin ────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@milkboy.app
SUPER_ADMIN_PASSWORD=SuperAdmin@123!
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
