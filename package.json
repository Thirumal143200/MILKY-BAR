{
  "name": "milkboy",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Milk Quality Detection Platform",
  "author": "MilkBoy Team",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "server",
    "web",
    "mobile"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:server": "npm run build --workspace=server",
    "build:web": "npm run build --workspace=web",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "format": "npx prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore",
    "format:check": "npx prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "db:reset": "npm run db:reset --workspace=server",
    "clean": "rimraf node_modules packages/*/node_modules server/node_modules web/node_modules"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "eslint": "^8.57.1",
    "react-native": "^0.86.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  },
  "optionalDependencies": {
    "@img/sharp-linux-x64": "0.34.5",
    "@img/sharp-libvips-linux-x64": "1.2.4",
    "@rollup/rollup-linux-x64-gnu": "4.62.2",
    "@rollup/rollup-linux-x64-musl": "4.62.2",
    "lightningcss-linux-x64-gnu": "1.30.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
